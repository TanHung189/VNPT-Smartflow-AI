# ============================================================
# VNPT SmartFlow AI — .gitignore
# ============================================================

# --- PYTHON / BACKEND ---
# Môi trường ảo
.venv/
venv/
env/
ENV/

# Tệp biên dịch và bộ nhớ đệm
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# --- NODE / FRONTEND ---
node_modules/
.pnp
.pnp.js

# Các thư mục build  
dist/
build/
out/
.next/

# --- CẤU HÌNH CÁ NHÂN & BẢO MẬT ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Docker volumes data
postgres_data/
redis_data/

# Cấu hình của trình soạn thảo
.vscode/
.idea/
*.swp
*.swo

# Hệ điều hành
.DS_Store
Thumbs.db

# Alembic (__pycache__ trong migrations)
backend/migrations/__pycache__/
