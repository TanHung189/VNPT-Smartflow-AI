# ============================================================
# VNPT SmartFlow AI — Environment Variables Template
# ============================================================
# Hướng dẫn sử dụng:
#   1. Sao chép file này: cp .env.example .env
#   2. Điền các giá trị thực vào từng biến bên dưới
#   3. KHÔNG commit file .env lên git (đã có trong .gitignore)
# ============================================================

# ─── DATABASE ────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=vnpt_smartflow_v1

# ─── BACKEND SECURITY ────────────────────────────────────────
# ⚠️ QUAN TRỌNG: Thay bằng giá trị ngẫu nhiên trước khi deploy!
# Tạo secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── GOOGLE GEMINI AI ────────────────────────────────────────
# Lấy API key tại: https://aistudio.google.com/apikey
# Hỗ trợ nhiều key phân cách bằng dấu phẩy (tự động rotate khi rate limit)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# ─── GOOGLE OAUTH 2.0 ────────────────────────────────────────
# Tạo tại: https://console.cloud.google.com/apis/credentials
# Sau khi tạo, thêm Authorized origins và redirect URIs:
#   - http://localhost:3000 (local dev)
#   - http://YOUR_VPS_IP:3000 (VPS deployment)
#   - https://yourdomain.com (production với domain)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── FRONTEND API URL ────────────────────────────────────────
# ⚠️  QUAN TRỌNG: Đây là URL mà BROWSER người dùng dùng để gọi API
# Không phải URL nội bộ giữa các container!
#
# Local development:   http://localhost:8000/api
# VPS (IP):            http://YOUR_VPS_IP:8000/api
# Production (domain): https://api.yourdomain.com/api
REACT_APP_API_BASE_URL=http://localhost:8000/api

# ─── LOCAL AI (OLLAMA) ────────────────────────────────────────
# Docker:    host.docker.internal:11434
# Local dev: localhost:11434
# VPS:       <ip-may-ollama>:11434  ← KHÔNG hardcode IP vào code
OLLAMA_HOST=host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ─── CORS ────────────────────────────────────────────────────
# Danh sách origin được phép, cách nhau bằng dấu phẩy
# Development: để trống (cho phép tất cả)
# Production:  CORS_ORIGINS=https://smartflow.vnpt.vn,https://www.smartflow.vnpt.vn
CORS_ORIGINS=

# ─── FRONTEND URL (để link email reset password) ─────────────
# Local dev:   http://localhost:3000
# Production:  https://smartflow.vnpt.vn
FRONTEND_URL=http://localhost:3000

# ─── EMAIL (Forgot Password) — Tuỳ chọn ──────────────────────
# Nếu để trống, reset link sẽ được log ra console thay vì gửi email
# Hỗ trợ Gmail SMTP (cần bật "App Password" trong Google Account)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=VNPT SmartFlow AI
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ─── RATE LIMITING ────────────────────────────────────────────
# Số request AI tối đa mỗi phút / IP (0 = tắt rate limit)
AI_RATE_LIMIT_PER_MINUTE=15

# ─── PASSWORD RESET TOKEN TTL ────────────────────────────────
# Thời gian hiệu lực của link reset mật khẩu (đơn vị: phút)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- MONITORING & OBSERVABILITY (Sentry) ---
# Dang ky mien phi tai https://sentry.io -> New Project -> FastAPI
# Vao Settings -> Client Keys (DSN) de copy DSN
# De trong neu chua muon dung (app van chay binh thuong)
SENTRY_DSN=
# Moi truong: development | staging | production
SENTRY_ENVIRONMENT=development
# Ty le lay mau performance trace (0.0 den 1.0). Khuyen nghi 0.1 cho production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- CELERY TASK QUEUE ---
# Cau hinh Celery tu dong doc REDIS_URL tu bien tren
# Worker chay: celery -A app.core.celery_app.celery_app worker --loglevel=info
# Flower UI tai: http://localhost:5555 (trong docker-compose)
