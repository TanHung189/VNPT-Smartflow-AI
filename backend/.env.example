# ============================================================
# backend/.env.example — Local Development Template
# ============================================================
# Dùng khi chạy backend TRỰC TIẾP (không qua Docker):
#   1. cp .env.example .env
#   2. Điền giá trị thực vào
#   3. uvicorn app.main:app --reload --port 8000
# ============================================================

# ─── DATABASE (Dùng khi chạy local, không qua Docker) ────────
# Cần PostgreSQL đang chạy local
DB_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/vnpt_smartflow_v1

# Thông tin PostgreSQL (nếu tự cài)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=vnpt_smartflow_v1

# ─── SECURITY ────────────────────────────────────────────────
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── GOOGLE GEMINI AI ────────────────────────────────────────
# Lấy API key tại: https://aistudio.google.com/apikey
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# ─── GOOGLE OAUTH 2.0 ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── LOCAL AI (OLLAMA) — Tùy chọn ───────────────────────────
OLLAMA_HOST=localhost:11434

# ─── SERVER ──────────────────────────────────────────────────
PORT=8000
